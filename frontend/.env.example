# Copy to .env.local (gitignored) and fill from the SAM stack Outputs:
#   sam deploy            # dev
#   aws cloudformation describe-stacks --stack-name careervault-dev \
#     --query "Stacks[0].Outputs" --output table

# Cognito User Pool issuer URL — https://cognito-idp.<region>.amazonaws.com/<CognitoUserPoolId>
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx

# CognitoUserPoolClientId output
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# CognitoHostedDomain output (no scheme) — used for the Hosted UI logout endpoint
VITE_COGNITO_DOMAIN=careervault-dev.auth.us-east-1.amazoncognito.com

# ApiGatewayBaseUrl output
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev

# Must match a Cognito callback/logout URL (CallbackUrl param; localhost for this slice)
VITE_REDIRECT_URI=http://localhost:5173
